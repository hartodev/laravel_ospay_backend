# ===== DEV (laptop / server testing) - salin ke .env di project lokal =====
# Pakai key SANDBOX Midtrans & IAK dan project Firebase DEV. Jangan pakai key production.
APP_NAME="OSPay Dev"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://192.168.1.10:8000
TENANCY_MAIN_DOMAIN=localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ospay_dev
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=database
SESSION_SECURE_COOKIE=false

MIDTRANS_MERCHANT_ID=<merchant-id-sandbox>
MIDTRANS_CLIENT_KEY=<client-key-sandbox>
MIDTRANS_SERVER_KEY=<server-key-sandbox>
MIDTRANS_PRODUCTION=false
MIDTRANS_IS_3DS=false

IAK_USERNAME=<username-iak>
IAK_API_KEY_DEV=<api-key-development-iak>   # CEK nama variabel di config/iak.php, sesuaikan
IAK_PRODUCTION=false

FCM_ENABLED=true
FCM_ANDROID_CHANNEL=ospay_transaksi
FIREBASE_CREDENTIALS=<path-ke>/fcm-service-account-dev.json
