# ===== PROD (server production) - salin ke /var/www/ospay/.env =====
APP_NAME=OSPay
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ospay.ptutamacta.com
TENANCY_MAIN_DOMAIN=ospay.ptutamacta.com

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ospay_prod
DB_USERNAME=ospay_app
DB_PASSWORD=<password-baru-yang-kuat>

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MIDTRANS_MERCHANT_ID=<merchant-id-production>
MIDTRANS_CLIENT_KEY=<client-key-production>
MIDTRANS_SERVER_KEY=<server-key-production>
MIDTRANS_PRODUCTION=true
MIDTRANS_IS_3DS=false

IAK_USERNAME=<username-iak>
IAK_API_KEY_PROD=<api-key-production-iak>
IAK_PRODUCTION=true

FCM_ENABLED=true
FCM_ANDROID_CHANNEL=ospay_transaksi
FIREBASE_CREDENTIALS=/etc/ospay/fcm-service-account.json
